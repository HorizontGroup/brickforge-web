    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ModelBuildData } from \'../types\';\n\ninterface PreviewViewProps {\n  model: ModelBuildData;\n  onBack: () => void;\n  onReplacePhoto: () => void;\n  onProceedToGenerate: () => void;\n}\n\nexport const PreviewView: React.FC<PreviewViewProps> = ({\n  model,\n  onBack,\n  onReplacePhoto,\n  onProceedToGenerate,\n}) => {\n  const [isZoomed, setIsZoomed] = useState(false);\n\n  return (\n    <div className=\"pt-24 pb-20 px-margin-mobile md:px-margin-tablet xl:px-margin-desktop max-w-[1360px] mx-auto min-h-screen\">\n      {/* Navigation & Breadcrumb Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8\">\n        <button\n          onClick={onBack}\n          className=\"inline-flex items-center gap-2 font-headline-sm text-sm text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer w-fit\"\n        >\n          <span className=\"material-symbols-outlined text-[18px]\">arrow_back</span>\n          <span>Back to home</span>\n        </button>\n\n        {/* Step Progress Indicators */}\n        <div className=\"flex items-center gap-2 text-xs font-bold text-on-surface-variant overflow-x-auto pb-1\">\n          <span className=\"flex items-center gap-1 text-primary\">\n            <span className=\"w-5 h-5 rounded-full bg-primary text-on-primary flex items-center justify-center text-[11px]\">\n              \342\234\223\n            </span>\n            <span>Upload Photo</span>\n          </span>\n          <span className=\"text-surface-dim\">/</span>\n          <span className=\"flex items-center gap-1 text-on-surface bg-surface-container px-2.5 py-1 rounded-full\">\n            <span className=\"w-5 h-5 rounded-full bg-on-surface text-surface flex items-center justify-center text-[11px]\">\n              2\n            </span>\n            <span>Order Preview</span>\n          </span>\n          <span className=\"text-surface-dim\">/</span>\n          <span className=\"flex items-center gap-1 text-on-surface-variant/60\">\n            <span className=\"w-5 h-5 rounded-full bg-surface-container-high text-on-surface-variant flex items-center justify-center text-[11px]\">\n              3\n            </span>\n            <span>Pipeline</span>\n          </span>\n          <span className=\"text-surface-dim\">/</span>\n          <span className=\"flex items-center gap-1 text-on-surface-variant/60\">\n            <span className=\"w-5 h-5 rounded-full bg-surface-container-high text-on-surface-variant flex items-center justify-center text-[11px]\">\n              4\n            </span>\n            <span>Result</span>\n          </span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* Left Column: Photo Verification Card (7 cols on desktop) */}\n        <div className=\"lg:col-span-7 bg-surface-container-lowest rounded-[28px] p-5 sm:p-7 border border-surface-container shadow-[0_6px_0_0_#eae7eb] flex flex-col\">\n          <div className=\"flex items-center justify-between mb-4\">\n            <div>\n              <span className=\"font-label-caps text-xs text-primary uppercase tracking-wider\">\n                Input Image Verification\n              </span>\n              <h2 className=\"font-headline-lg text-xl sm:text-2xl text-on-surface mt-1\">\n                {model.name}\n              </h2>\n            </div>\n            <button\n              onClick={onReplacePhoto}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-xs font-bold text-on-surface-variant transition-all border border-surface-container cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">sync</span>\n              <span>Replace Photo</span>\n            </button>\n          </div>\n\n          {/* Photo Frame */}\n          <div\n            onClick={() => setIsZoomed(!isZoomed)}\n            className=\"relative w-full aspect-4/3 rounded-2xl overflow-hidden bg-surface-container-low cursor-zoom-in border border-surface-container shadow-inner group\"\n          >\n            <img\n              src={model.photoUrl}\n              alt=\"Uploaded reference\"\n              className={`w-full h-full object-cover transition-transform duration-300 ${\n                isZoomed ? \'scale-125\' : \'group-hover:scale-105\'\n              }`}\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute top-3 left-3 bg-on-surface/75 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-surface flex items-center gap-1.5\">\n              <span className=\"material-symbols-outlined text-[14px]\">photo_camera</span>\n              <span>Input Reference</span>\n            </div>\n            <div className=\"absolute bottom-3 right-3 bg-surface/90 backdrop-blur-md px-3 py-1.5 rounded-xl text-xs font-bold text-on-surface flex items-center gap-1 shadow-sm\">\n              <span className=\"material-symbols-outlined text-[16px]\">\n                {isZoomed ? \'zoom_out\' : \'zoom_in\'}\n              </span>\n              <span>{isZoomed ? \'Zoom Out\' : \'Click to Zoom\'}</span>\n            </div>\n          </div>\n\n          {/* Analysis Note */}\n          <div className=\"mt-4 p-3.5 rounded-xl bg-surface-container-low border border-surface-container flex items-start gap-3\">\n            <span className=\"material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5\">\n              document_scanner\n            </span>\n            <div className=\"text-xs text-on-surface-variant leading-relaxed\">\n              <span className=\"font-bold text-on-surface\">Subject Geometry Detected: </span>\n              High-contrast contours detected. Suitable for modular 1x1 stud plate resolution and structural ABS locking layers.\n            </div>\n          </div>\n\n          {/* Specifications Grid */}\n          <div className=\"mt-6 pt-5 border-t border-surface-container grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            <div className=\"bg-surface-container-low p-3 rounded-xl\">\n              <p className=\"font-label-caps text-[10px] text-on-surface-variant uppercase\">Piece Count</p>\n              <p className=\"font-headline-sm text-base font-extrabold text-on-surface mt-0.5\">\n                ~{model.pieceCount} pcs\n              </p>\n            </div>\n            <div className=\"bg-surface-container-low p-3 rounded-xl\">\n              <p className=\"font-label-caps text-[10px] text-on-surface-variant uppercase\">Build Steps</p>\n              <p className=\"font-headline-sm text-base font-extrabold text-on-surface mt-0.5\">\n                {model.buildSteps} Steps\n              </p>\n            </div>\n            <div className=\"bg-surface-container-low p-3 rounded-xl\">\n              <p className=\"font-label-caps text-[10px] text-on-surface-variant uppercase\">Scale / Dim</p>\n              <p className=\"font-headline-sm text-base font-extrabold text-on-surface mt-0.5\">\n                {model.dimensions}\n              </p>\n            </div>\n            <div className=\"bg-surface-container-low p-3 rounded-xl\">\n              <p className=\"font-label-caps text-[10px] text-on-surface-variant uppercase\">Builder Tier</p>\n              <p className=\"font-headline-sm text-base font-extrabold text-on-surface mt-0.5\">\n                {model.tier}\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Order & Blueprint Package Summary (5 cols on desktop) */}\n        <div className=\"lg:col-span-5 bg-surface-container-lowest rounded-[28px] p-6 sm:p-8 border border-surface-container shadow-[0_6px_0_0_#eae7eb] flex flex-col sticky top-28\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-bold w-fit mb-3\">\n            <span className=\"material-symbols-outlined text-[14px]\">view_in_ar</span>\n            <span>Digital Blueprint Package</span>\n          </div>\n\n          <h3 className=\"font-headline-xl text-2xl text-on-surface mb-2\">\n            Custom Brick MOC Blueprint\n          </h3>\n          <p className=\"font-body-md text-sm text-on-surface-variant mb-6\">\n            Everything needed to physically source parts and assemble your model.\n          </p>\n\n          {/* Included Deliverables List */}\n          <div className=\"space-y-3.5 mb-8\">\n            <div className=\"flex items-start gap-3\">\n              <div className=\"w-5 h-5 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5\">\n                <span className=\"material-symbols-outlined text-[14px] font-bold\">check</span>\n              </div>\n              <div className=\"text-xs\">\n                <p className=\"font-bold text-on-surface\">Step-by-Step PDF Manual</p>\n                <p className=\"text-on-surface-variant\">Full-color printable instruction booklet with sub-assemblies</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-3\">\n              <div className=\"w-5 h-5 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5\">\n                <span className=\"material-symbols-outlined text-[14px] font-bold\">check</span>\n              </div>\n              <div className=\"text-xs\">\n                <p className=\"font-bold text-on-surface\">Official LDraw 3D Model File (.ldr)</p>\n                <p className=\"text-on-surface-variant\">Standard CAD file for Studio 2.0 and digital builders</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-3\">\n              <div className=\"w-5 h-5 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5\">\n                <span className=\"material-symbols-outlined text-[14px] font-bold\">check</span>\n              </div>\n              <div className=\"text-xs\">\n                <p className=\"font-bold text-on-surface\">Element Sourcing XML &amp; CSV Manifest</p>\n                <p className=\"text-on-surface-variant\">Detailed part IDs, colors, and quantities for element sourcing</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-3\">\n              <div className=\"w-5 h-5 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5\">\n                <span className=\"material-symbols-outlined text-[14px] font-bold\">check</span>\n              </div>\n              <div className=\"text-xs\">\n                <p className=\"font-bold text-on-surface\">Clutch &amp; Tabletop Stability Verified</p>\n                <p className=\"text-on-surface-variant\">Guaranteed real ABS physical interlock without illegal stress</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Pricing Box */}\n          <div className=\"bg-surface-container-low rounded-2xl p-4 border border-surface-container mb-6\">\n            <div className=\"flex items-baseline justify-between mb-1\">\n              <span className=\"font-headline-sm text-sm text-on-surface\">Blueprint Package</span>\n              <span className=\"font-display-hero text-2xl text-primary font-extrabold\">$19.00 USD</span>\n            </div>\n            <p className=\"text-[11px] text-on-surface-variant\">\n              One-time generation fee. Includes immediate CAD export and printable PDF download.\n            </p>\n          </div>\n\n          {/* Action Button */}\n          <button\n            onClick={onProceedToGenerate}\n            className=\"w-full h-[58px] rounded-xl font-headline-sm text-base text-on-primary bg-primary shadow-[0_6px_0_0_#910b00] hover:bg-primary-container active:translate-y-[3px] active:shadow-[0_2px_0_0_#910b00] transition-all flex items-center justify-center gap-3 cursor-pointer mb-3\"\n          >\n            <span>Build My Model</span>\n            <span className=\"material-symbols-outlined text-[20px]\">construction</span>\n          </button>\n\n          <p className=\"text-[11px] text-center text-on-surface-variant flex items-center justify-center gap-1\">\n            <span className=\"material-symbols-outlined text-[14px] text-secondary\">verified_user</span>\n            <span>Standard ABS Mold Tolerances \342\200\242 Physical Assembly Ready</span>\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
