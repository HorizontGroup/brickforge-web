  file_change {
    absolute_path_uri: "file:///src/components/GeneratingView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { ModelBuildData } from \'../types\';\n\ninterface GeneratingViewProps {\n  model: ModelBuildData;\n  onComplete: () => void;\n}\n\nexport const GeneratingView: React.FC<GeneratingViewProps> = ({\n  model,\n  onComplete,\n}) => {\n  const [progress, setProgress] = useState(18);\n  const [currentStage, setCurrentStage] = useState(0);\n  const [activeLayer, setActiveLayer] = useState(4);\n  const [studsMapped, setStudsMapped] = useState(380);\n\n  const stages = [\n    {\n      title: \'Analyzing Photo Geometry\',\n      desc: \'Detecting contours, optical depth planes, and key feature lines\',\n      icon: \'document_scanner\',\n    },\n    {\n      title: \'Synthesizing Brick Structure\',\n      desc: \'Mapping interlocking bricks, plates, and slopes into a solid core\',\n      icon: \'view_in_ar\',\n    },\n    {\n      title: \'Checking Clutch & Connections\',\n      desc: \'Verifying gravity balance, shear loads, and tabletop stability\',\n      icon: \'rule\',\n    },\n    {\n      title: \'Creating Step-by-Step Instructions\',\n      desc: \'Compiling high-resolution PDF pages, LDraw CAD, and parts manifest\',\n      icon: \'auto_stories\',\n    },\n  ];\n\n  const craftsmanshipInsights = [\n    \'Overlapping brick seams prevent structural splitting during physical tabletop assembly.\',\n    \'Every piece is matched against standard commercial ABS elements.\',\n    \'The generated LDraw CAD file (.ldr) is fully compatible with digital design viewers.\',\n  ];\n  const [insightIndex, setInsightIndex] = useState(0);\n\n  useEffect(() => {\n    // Progress increment timer\n    const interval = setInterval(() => {\n      setProgress((prev) => {\n        if (prev >= 100) {\n          clearInterval(interval);\n          setTimeout(onComplete, 800);\n          return 100;\n        }\n        const next = prev + Math.floor(Math.random() * 8) + 4;\n        const capped = Math.min(next, 100);\n\n        // Update stages\n        if (capped > 75) setCurrentStage(3);\n        else if (capped > 50) setCurrentStage(2);\n        else if (capped > 25) setCurrentStage(1);\n        else setCurrentStage(0);\n\n        setActiveLayer(Math.min(28, Math.floor((capped / 100) * 28)));\n        setStudsMapped(Math.floor((capped / 100) * 1480));\n\n        return capped;\n      });\n    }, 450);\n\n    const insightInterval = setInterval(() => {\n      setInsightIndex((i) => (i + 1) % craftsmanshipInsights.length);\n    }, 3200);\n\n    return () => {\n      clearInterval(interval);\n      clearInterval(insightInterval);\n    };\n  }, [onComplete]);\n\n  return (\n    <div className=\"pt-24 pb-20 px-margin-mobile md:px-margin-tablet xl:px-margin-desktop max-w-[1360px] mx-auto min-h-screen flex flex-col justify-center\">\n      {/* Top Banner */}\n      <div className=\"max-w-3xl mx-auto w-full text-center mb-8\">\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-bold mb-4 shadow-[0_2px_0_0_#f6bf22]\">\n          <span className=\"material-symbols-outlined text-[14px] animate-spin\">sync</span>\n          <span>Assembly Pipeline In Progress</span>\n        </div>\n        <h1 className=\"font-display-hero text-2xl sm:text-3xl md:text-4xl text-on-surface mb-3\">\n          Synthesizing Your Custom Brick Model\n        </h1>\n        <p className=\"font-body-md text-sm sm:text-base text-on-surface-variant max-w-xl mx-auto\">\n          Translating your reference photo into an interlocking physical ABS structure.\n        </p>\n      </div>\n\n      {/* Progress Bar Container */}\n      <div className=\"max-w-3xl mx-auto w-full bg-surface-container-lowest rounded-2xl p-4 sm:p-6 border border-surface-container shadow-[0_4px_0_0_#eae7eb] mb-8\">\n        <div className=\"flex items-center justify-between mb-2 font-headline-sm text-sm\">\n          <span className=\"text-on-surface font-bold\">\n            {currentStage < stages.length ? stages[currentStage].title : \'Finalizing Blueprint...\'}\n          </span>\n          <span className=\"text-primary font-extrabold\">{progress}%</span>\n        </div>\n        <div className=\"w-full h-3 bg-surface-container rounded-full overflow-hidden p-0.5\">\n          <div\n            className=\"h-full bg-primary rounded-full transition-all duration-300 shadow-[0_2px_0_0_#910b00]\"\n            style={{ width: `${progress}%` }}\n          />\n        </div>\n      </div>\n\n      {/* Main Grid: Sandbox Visualizer (Left) + Pipeline Stages (Right) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch max-w-5xl mx-auto w-full\">\n        {/* Left: 3D Synthesis Sandbox / Hologram Visualizer */}\n        <div className=\"lg:col-span-7 bg-surface-container-lowest rounded-[28px] p-6 border border-surface-container shadow-[0_6px_0_0_#eae7eb] flex flex-col justify-between relative overflow-hidden\">\n          <div className=\"flex items-center justify-between mb-4 z-10\">\n            <span className=\"font-label-caps text-[11px] text-on-surface-variant bg-surface-container-low px-2.5 py-1 rounded-md border border-surface-container\">\n              VOXEL LATTICE: LAYER {activeLayer}/28\n            </span>\n            <span className=\"font-label-numeric text-[11px] text-primary font-bold\">\n              {studsMapped} STUDS MAPPED\n            </span>\n          </div>\n\n          {/* Model Preview with Scanline Animation */}\n          <div className=\"relative w-full aspect-square max-w-[360px] mx-auto rounded-2xl overflow-hidden bg-surface-container-low/70 flex items-center justify-center border border-surface-container shadow-inner\">\n            {/* Background grid pattern */}\n            <div\n              className=\"absolute inset-0 opacity-15 pointer-events-none\"\n              style={{\n                backgroundImage:\n                  \'radial-gradient(#5d403a 1.5px, transparent 1.5px), radial-gradient(#5d403a 1.5px, #f6f2f7 1.5px)\',\n                backgroundSize: \'24px 24px\',\n                backgroundPosition: \'0 0, 12px 12px\',\n              }}\n            />\n\n            {/* Model Render */}\n            <img\n              src={model.renderUrl}\n              alt=\"Model synthesis\"\n              className=\"w-[85%] h-[85%] object-contain relative z-10 transition-opacity duration-300\"\n              style={{\n                filter: progress < 50 ? \'grayscale(40%) contrast(110%)\' : \'none\',\n              }}\n              referrerPolicy=\"no-referrer\"\n            />\n\n            {/* Scanline sweep */}\n            <div\n              className=\"absolute inset-x-0 h-8 bg-gradient-to-b from-transparent via-primary/25 to-transparent pointer-events-none z-20 animate-bounce\"\n              style={{ animationDuration: \'2.4s\' }}\n            />\n\n            {/* Floating Live Badge */}\n            <div className=\"absolute bottom-3 left-3 bg-surface/90 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-bold text-on-surface shadow-sm flex items-center gap-1.5 z-20\">\n              <span className=\"w-2 h-2 rounded-full bg-secondary animate-ping\" />\n              <span>Checking Interlock Clutch</span>\n            </div>\n          </div>\n\n          {/* Real-time Sub-metrics */}\n          <div className=\"mt-5 grid grid-cols-3 gap-2 pt-4 border-t border-surface-container text-center\">\n            <div className=\"bg-surface-container-low p-2 rounded-xl\">\n              <p className=\"text-[10px] uppercase font-bold text-on-surface-variant\">Clutch Score</p>\n              <p className=\"text-sm font-extrabold text-on-surface\">99.8%</p>\n            </div>\n            <div className=\"bg-surface-container-low p-2 rounded-xl\">\n              <p className=\"text-[10px] uppercase font-bold text-on-surface-variant\">Unique Parts</p>\n              <p className=\"text-sm font-extrabold text-on-surface\">{model.uniqueTypes} types</p>\n            </div>\n            <div className=\"bg-surface-container-low p-2 rounded-xl\">\n              <p className=\"text-[10px] uppercase font-bold text-on-surface-variant\">Total Elements</p>\n              <p className=\"text-sm font-extrabold text-primary\">{model.pieceCount} pcs</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Right: Pipeline Checklist */}\n        <div className=\"lg:col-span-5 flex flex-col gap-4\">\n          <div className=\"bg-surface-container-lowest rounded-[28px] p-6 border border-surface-container shadow-[0_6px_0_0_#eae7eb] flex-1\">\n            <h3 className=\"font-headline-sm text-base text-on-surface mb-4\">\n              Assembly Pipeline\n            </h3>\n\n            <div className=\"space-y-4\">\n              {stages.map((stg, idx) => {\n                const isCompleted = currentStage > idx || progress === 100;\n                const isCurrent = currentStage === idx && progress < 100;\n                const isPending = currentStage < idx;\n\n                return (\n                  <div\n                    key={stg.title}\n                    className={`flex items-start gap-3 p-3 rounded-xl transition-all ${\n                      isCurrent\n                        ? \'bg-primary-fixed/20 border border-primary-fixed\'\n                        : isCompleted\n                        ? \'bg-surface-container-low/60\'\n                        : \'opacity-40\'\n                    }`}\n                  >\n                    <div\n                      className={`w-7 h-7 rounded-lg flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold ${\n                        isCompleted\n                          ? \'bg-primary text-on-primary shadow-[0_2px_0_0_#910b00]\'\n                          : isCurrent\n                          ? \'bg-secondary-container text-on-secondary-container animate-pulse\'\n                          : \'bg-surface-container text-on-surface-variant\'\n                      }`}\n                    >\n                      {isCompleted ? (\n                        <span className=\"material-symbols-outlined text-[16px]\">check</span>\n                      ) : (\n                        idx + 1\n                      )}\n                    </div>\n                    <div className=\"min-w-0\">\n                      <p className=\"font-headline-sm text-xs text-on-surface font-bold\">\n                        {stg.title}\n                      </p>\n                      <p className=\"font-body-sm text-[11px] text-on-surface-variant mt-0.5 leading-snug\">\n                        {stg.desc}\n                      </p>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Craftsmanship Insights Pill */}\n          <div className=\"bg-surface-container-low rounded-2xl p-4 border border-surface-container\">\n            <div className=\"flex items-center gap-2 text-xs font-bold text-secondary mb-1\">\n              <span className=\"material-symbols-outlined text-[16px]\">lightbulb</span>\n              <span>Craftsmanship Standard</span>\n            </div>\n            <p className=\"text-xs text-on-surface-variant leading-relaxed min-h-[36px]\">\n              {craftsmanshipInsights[insightIndex]}\n            </p>\n          </div>\n\n          {/* Manual advance shortcut if user wants instant result */}\n          <button\n            onClick={onComplete}\n            className=\"w-full py-2.5 rounded-xl font-headline-sm text-xs text-on-surface-variant hover:text-on-surface bg-surface-container-low hover:bg-surface-container border border-surface-container transition-all cursor-pointer text-center\"\n          >\n            Skip to Result Screen \342\206\222\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
