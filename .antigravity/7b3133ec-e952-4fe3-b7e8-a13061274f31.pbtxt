    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ModelBuildData } from \'../types\';\nimport {\n  downloadLDrawFile,\n  downloadBOMCsv,\n  downloadAssemblyPdf,\n} from \'../utils/fileGenerators\';\n\ninterface ResultViewProps {\n  model: ModelBuildData;\n  onNewBuild: () => void;\n  onBackToHome: () => void;\n}\n\nexport const ResultView: React.FC<ResultViewProps> = ({\n  model,\n  onNewBuild,\n  onBackToHome,\n}) => {\n  const [currentStepIndex, setCurrentStepIndex] = useState(0);\n  const [rotationAngle, setRotationAngle] = useState(0);\n  const [zoomLevel, setZoomLevel] = useState(1);\n  const [showOriginalPip, setShowOriginalPip] = useState(true);\n\n  const currentStep = model.steps[currentStepIndex] || model.steps[0];\n  const totalSteps = model.steps.length;\n\n  const handleNextStep = () => {\n    if (currentStepIndex < totalSteps - 1) {\n      setCurrentStepIndex(currentStepIndex + 1);\n    }\n  };\n\n  const handlePrevStep = () => {\n    if (currentStepIndex > 0) {\n      setCurrentStepIndex(currentStepIndex - 1);\n    }\n  };\n\n  const handleRotate = (direction: \'left\' | \'right\') => {\n    setRotationAngle((prev) => (direction === \'left\' ? prev - 45 : prev + 45));\n  };\n\n  const handleZoom = (direction: \'in\' | \'out\') => {\n    setZoomLevel((prev) => {\n      if (direction === \'in\') return Math.min(prev + 0.2, 1.8);\n      return Math.max(prev - 0.2, 0.8);\n    });\n  };\n\n  const handleResetCad = () => {\n    setRotationAngle(0);\n    setZoomLevel(1);\n  };\n\n  return (\n    <div className=\"pt-24 pb-20 px-margin-mobile md:px-margin-tablet xl:px-margin-desktop max-w-[1360px] mx-auto min-h-screen\">\n      {/* Top Header & Breadcrumb */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6\">\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={onBackToHome}\n            className=\"w-9 h-9 rounded-xl bg-surface-container-low hover:bg-surface-container flex items-center justify-center text-on-surface-variant transition-colors cursor-pointer border border-surface-container\"\n            title=\"Home\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">home</span>\n          </button>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-label-caps text-[10px] text-primary uppercase font-bold tracking-wider\">\n                Model #{model.id}\n              </span>\n              <span className=\"text-surface-dim\">\342\200\242</span>\n              <span className=\"font-label-caps text-[10px] text-secondary uppercase font-bold tracking-wider\">\n                {model.tier} Tier\n              </span>\n            </div>\n            <h1 className=\"font-headline-lg text-xl sm:text-2xl text-on-surface font-extrabold\">\n              {model.name}\n            </h1>\n          </div>\n        </div>\n\n        <button\n          onClick={onNewBuild}\n          className=\"inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container border border-surface-container text-xs font-bold text-on-surface shadow-[0_2px_0_0_#eae7eb] active:translate-y-0.5 transition-all cursor-pointer w-fit\"\n        >\n          <span className=\"material-symbols-outlined text-[16px]\">add_a_photo</span>\n          <span>Build Another Model</span>\n        </button>\n      </div>\n\n      {/* Main Grid: CAD Stage & Scrubber (Left 7 cols) + Deliverables & Specs (Right 5 cols) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* LEFT COLUMN: 3D CAD Stage + Assembly Scrubber */}\n        <div className=\"lg:col-span-7 flex flex-col gap-6\">\n          {/* 3D Viewport Card */}\n          <div className=\"bg-surface-container-lowest rounded-[28px] p-5 sm:p-6 border border-surface-container shadow-[0_6px_0_0_#eae7eb] relative flex flex-col\">\n            {/* Viewport Top Bar */}\n            <div className=\"flex items-center justify-between pb-3 mb-2 border-b border-surface-container\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-6 h-6 rounded-md bg-tertiary-fixed text-tertiary flex items-center justify-center\">\n                  <span className=\"material-symbols-outlined text-[14px]\">view_in_ar</span>\n                </div>\n                <span className=\"font-label-caps text-xs text-on-surface font-bold uppercase\">\n                  LDraw CAD Viewport\n                </span>\n                <span className=\"text-xs text-on-surface-variant font-medium\">\n                  ({model.dimensions})\n                </span>\n              </div>\n\n              <div className=\"flex items-center gap-1.5\">\n                <button\n                  onClick={() => setShowOriginalPip(!showOriginalPip)}\n                  className={`px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1 transition-colors ${\n                    showOriginalPip\n                      ? \'bg-surface-container-high text-on-surface\'\n                      : \'bg-surface-container-low text-on-surface-variant\'\n                  }`}\n                  title=\"Toggle Photo Comparison\"\n                >\n                  <span className=\"material-symbols-outlined text-[14px]\">compare</span>\n                  <span className=\"hidden sm:inline\">Photo PIP</span>\n                </button>\n\n                <button\n                  onClick={handleResetCad}\n                  className=\"w-7 h-7 rounded-lg bg-surface-container-low hover:bg-surface-container flex items-center justify-center text-on-surface-variant\"\n                  title=\"Reset View\"\n                >\n                  <span className=\"material-symbols-outlined text-[16px]\">restart_alt</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Interactive 3D Model Display Stage */}\n            <div className=\"relative w-full aspect-4/3 rounded-2xl overflow-hidden bg-surface-container-low flex items-center justify-center border border-surface-container shadow-inner\">\n              {/* Subtle background grid */}\n              <div\n                className=\"absolute inset-0 opacity-20 pointer-events-none\"\n                style={{\n                  backgroundImage:\n                    \'radial-gradient(#916f69 1.5px, transparent 1.5px), radial-gradient(#916f69 1.5px, #f6f2f7 1.5px)\',\n                  backgroundSize: \'20px 20px\',\n                  backgroundPosition: \'0 0, 10px 10px\',\n                }}\n              />\n\n              {/* Centered Render with Interactive Transform */}\n              <div\n                className=\"transition-transform duration-300 ease-out select-none flex items-center justify-center w-full h-full p-6\"\n                style={{\n                  transform: `scale(${zoomLevel}) rotate(${rotationAngle}deg)`,\n                }}\n              >\n                <img\n                  src={model.renderUrl}\n                  alt={model.name}\n                  className=\"max-w-[90%] max-h-[90%] object-contain drop-shadow-xl\"\n                  referrerPolicy=\"no-referrer\"\n                />\n              </div>\n\n              {/* Floating Picture-in-Picture Original Photo */}\n              {showOriginalPip && (\n                <div className=\"absolute top-3 left-3 w-24 h-24 sm:w-28 sm:h-28 rounded-xl overflow-hidden shadow-[0_4px_12px_rgba(0,0,0,0.15)] border-2 border-surface-container-lowest bg-surface group transition-all\">\n                  <img\n                    src={model.photoUrl}\n                    alt=\"Original reference\"\n                    className=\"w-full h-full object-cover\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute bottom-0 inset-x-0 bg-on-surface/85 backdrop-blur-sm text-[9px] font-bold text-center text-surface py-0.5 uppercase tracking-wide\">\n                    Original\n                  </div>\n                </div>\n              )}\n\n              {/* CAD Orbit & Zoom Floating Controls Bar */}\n              <div className=\"absolute bottom-3 inset-x-0 flex justify-center pointer-events-none\">\n                <div className=\"bg-surface/90 backdrop-blur-md px-3 py-1.5 rounded-full shadow-[0_4px_12px_rgba(0,0,0,0.08)] border border-surface-container flex items-center gap-1.5 pointer-events-auto\">\n                  <button\n                    onClick={() => handleRotate(\'left\')}\n                    className=\"w-8 h-8 rounded-full hover:bg-surface-container flex items-center justify-center text-on-surface transition-colors cursor-pointer\"\n                    title=\"Rotate Left 45\302\260\"\n                  >\n                    <span className=\"material-symbols-outlined text-[18px]\">rotate_left</span>\n                  </button>\n                  <button\n                    onClick={() => handleZoom(\'out\')}\n                    className=\"w-8 h-8 rounded-full hover:bg-surface-container flex items-center justify-center text-on-surface transition-colors cursor-pointer\"\n                    title=\"Zoom Out\"\n                  >\n                    <span className=\"material-symbols-outlined text-[18px]\">zoom_out</span>\n                  </button>\n                  <span className=\"text-[11px] font-bold text-on-surface-variant px-1 font-mono\">\n                    {Math.round(zoomLevel * 100)}%\n                  </span>\n                  <button\n                    onClick={() => handleZoom(\'in\')}\n                    className=\"w-8 h-8 rounded-full hover:bg-surface-container flex items-center justify-center text-on-surface transition-colors cursor-pointer\"\n                    title=\"Zoom In\"\n                  >\n                    <span className=\"material-symbols-outlined text-[18px]\">zoom_in</span>\n                  </button>\n                  <button\n                    onClick={() => handleRotate(\'right\')}\n                    className=\"w-8 h-8 rounded-full hover:bg-surface-container flex items-center justify-center text-on-surface transition-colors cursor-pointer\"\n                    title=\"Rotate Right 45\302\260\"\n                  >\n                    <span className=\"material-symbols-outlined text-[18px]\">rotate_right</span>\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* ASSEMBLY SEQUENCE SCRUBBER (Under CAD stage) */}\n          <div className=\"bg-surface-container-lowest rounded-[24px] p-5 sm:p-6 border border-surface-container shadow-[0_4px_0_0_#eae7eb]\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"w-2.5 h-2.5 rounded-full bg-secondary\" />\n                <span className=\"font-label-caps text-xs text-on-surface font-bold uppercase\">\n                  Assembly Sequence\n                </span>\n              </div>\n              <span className=\"font-headline-sm text-xs font-bold text-primary bg-primary-fixed/40 px-2.5 py-1 rounded-full\">\n                Step {(currentStepIndex + 1).toString().padStart(2, \'0\')} of{\' \'}\n                {totalSteps.toString().padStart(2, \'0\')}\n              </span>\n            </div>\n\n            {/* Active Step Details */}\n            <div className=\"bg-surface-container-low rounded-xl p-4 mb-4 border border-surface-container\">\n              <div className=\"flex items-baseline justify-between mb-1\">\n                <h3 className=\"font-headline-sm text-base text-on-surface font-bold\">\n                  {currentStep.title}\n                </h3>\n                <span className=\"text-xs font-bold text-on-surface-variant\">\n                  {currentStep.piecesUsed} pieces in this step\n                </span>\n              </div>\n              <p className=\"font-body-md text-xs text-on-surface-variant\">\n                {currentStep.description}\n              </p>\n            </div>\n\n            {/* Interactive Timeline Scrubber Slider */}\n            <div className=\"mb-4\">\n              <input\n                type=\"range\"\n                min={0}\n                max={totalSteps - 1}\n                value={currentStepIndex}\n                onChange={(e) => setCurrentStepIndex(parseInt(e.target.value, 10))}\n                className=\"w-full accent-primary h-2 bg-surface-container rounded-lg appearance-none cursor-pointer\"\n              />\n              <div className=\"flex justify-between text-[10px] font-bold text-on-surface-variant/70 mt-1\">\n                <span>Start (Base)</span>\n                <span>Mid Assembly</span>\n                <span>Final Polish</span>\n              </div>\n            </div>\n\n            {/* Scrubber Controls Row */}\n            <div className=\"flex items-center justify-between gap-3\">\n              <button\n                onClick={handlePrevStep}\n                disabled={currentStepIndex === 0}\n                className=\"inline-flex items-center gap-1.5 px-4 h-[42px] rounded-xl font-headline-sm text-xs text-on-surface bg-surface-container-low hover:bg-surface-container disabled:opacity-30 disabled:pointer-events-none border border-surface-container shadow-[0_2px_0_0_#eae7eb] active:translate-y-0.5 transition-all cursor-pointer\"\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">arrow_back</span>\n                <span>Previous Step</span>\n              </button>\n\n              <span className=\"text-xs font-mono font-bold text-on-surface-variant\">\n                {currentStepIndex + 1} / {totalSteps}\n              </span>\n\n              <button\n                onClick={handleNextStep}\n                disabled={currentStepIndex === totalSteps - 1}\n                className=\"inline-flex items-center gap-1.5 px-4 h-[42px] rounded-xl font-headline-sm text-xs text-on-primary bg-primary hover:bg-primary-container disabled:opacity-30 disabled:pointer-events-none shadow-[0_3px_0_0_#910b00] active:translate-y-0.5 transition-all cursor-pointer\"\n              >\n                <span>Next Step</span>\n                <span className=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* RIGHT COLUMN: Model Summary, Verification & Deliverables */}\n        <div className=\"lg:col-span-5 flex flex-col gap-6\">\n          {/* Card 1: Model Summary & Specs */}\n          <div className=\"bg-surface-container-lowest rounded-[28px] p-6 border border-surface-container shadow-[0_6px_0_0_#eae7eb]\">\n            <span className=\"font-label-caps text-[11px] text-primary uppercase tracking-wider font-bold\">\n              Model Specifications\n            </span>\n            <h2 className=\"font-headline-lg text-2xl text-on-surface mt-1 mb-4\">\n              {model.name}\n            </h2>\n\n            {/* Key Stat Blocks */}\n            <div className=\"grid grid-cols-3 gap-3 mb-6\">\n              <div className=\"bg-surface-container-low p-3.5 rounded-2xl border border-surface-container text-center\">\n                <p className=\"font-label-caps text-[10px] text-on-surface-variant uppercase\">Real ABS Parts</p>\n                <p className=\"font-display-hero text-2xl text-primary font-extrabold mt-0.5\">\n                  {model.pieceCount}\n                </p>\n              </div>\n              <div className=\"bg-surface-container-low p-3.5 rounded-2xl border border-surface-container text-center\">\n                <p className=\"font-label-caps text-[10px] text-on-surface-variant uppercase\">Unique Types</p>\n                <p className=\"font-display-hero text-2xl text-on-surface font-extrabold mt-0.5\">\n                  {model.uniqueTypes}\n                </p>\n              </div>\n              <div className=\"bg-surface-container-low p-3.5 rounded-2xl border border-surface-container text-center\">\n                <p className=\"font-label-caps text-[10px] text-on-surface-variant uppercase\">Build Steps</p>\n                <p className=\"font-display-hero text-2xl text-on-surface font-extrabold mt-0.5\">\n                  {model.buildSteps}\n                </p>\n              </div>\n            </div>\n\n            {/* Color Palette Breakdown */}\n            <div>\n              <p className=\"font-label-caps text-[11px] text-on-surface-variant uppercase font-bold mb-2\">\n                Color Composition\n              </p>\n              <div className=\"flex h-3 rounded-full overflow-hidden mb-3 border border-surface-container\">\n                {model.colors.map((c) => {\n                  const pct = Math.round((c.count / model.pieceCount) * 100);\n                  return (\n                    <div\n                      key={c.name}\n                      style={{ width: `${pct}%`, backgroundColor: c.hex }}\n                      title={`${c.name}: ${c.count} parts (${pct}%)`}\n                    />\n                  );\n                })}\n              </div>\n              <div className=\"flex flex-wrap gap-2 text-xs\">\n                {model.colors.map((c) => (\n                  <span\n                    key={c.name}\n                    className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-container-low border border-surface-container font-medium text-on-surface\"\n                  >\n                    <span\n                      className=\"w-2.5 h-2.5 rounded-full border border-black/20\"\n                      style={{ backgroundColor: c.hex }}\n                    />\n                    <span>{c.name}</span>\n                    <span className=\"text-on-surface-variant font-bold\">({c.count})</span>\n                  </span>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          {/* Card 2: Physical Buildability Verification */}\n          <div className=\"bg-surface-container-lowest rounded-[28px] p-6 border border-surface-container shadow-[0_6px_0_0_#eae7eb]\">\n            <div className=\"flex items-center gap-2 mb-3\">\n              <span className=\"material-symbols-outlined text-primary text-[20px]\">verified</span>\n              <h3 className=\"font-headline-sm text-sm text-on-surface font-bold uppercase tracking-wide\">\n                Buildability Verified\n              </h3>\n            </div>\n\n            <div className=\"space-y-2 text-xs text-on-surface-variant\">\n              <div className=\"flex items-center gap-2 p-2 rounded-xl bg-surface-container-low\">\n                <span className=\"material-symbols-outlined text-secondary text-[16px]\">check_circle</span>\n                <span>ABS Mold Tolerances: 8.0mm stud pitch verified</span>\n              </div>\n              <div className=\"flex items-center gap-2 p-2 rounded-xl bg-surface-container-low\">\n                <span className=\"material-symbols-outlined text-secondary text-[16px]\">check_circle</span>\n                <span>Interlock Stability: Cross-layer seams tested</span>\n              </div>\n              <div className=\"flex items-center gap-2 p-2 rounded-xl bg-surface-container-low\">\n                <span className=\"material-symbols-outlined text-secondary text-[16px]\">check_circle</span>\n                <span>Commercial Availability: Standard catalog piece IDs</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Card 3: Deliverables & Download Section */}\n          <div className=\"bg-surface-container-lowest rounded-[28px] p-6 border border-surface-container shadow-[0_6px_0_0_#eae7eb]\">\n            <h3 className=\"font-headline-sm text-base text-on-surface mb-2 font-extrabold\">\n              Download Your Deliverables\n            </h3>\n            <p className=\"font-body-md text-xs text-on-surface-variant mb-5\">\n              Access your full assembly blueprint, 3D CAD model, and parts list.\n            </p>\n\n            <div className=\"space-y-3\">\n              {/* PDF Guide Download */}\n              <button\n                onClick={() => downloadAssemblyPdf(model)}\n                className=\"w-full h-[52px] rounded-xl font-headline-sm text-sm text-on-primary bg-primary shadow-[0_4px_0_0_#910b00] hover:bg-primary-container active:translate-y-0.5 active:shadow-[0_1px_0_0_#910b00] transition-all flex items-center justify-between px-4 cursor-pointer\"\n              >\n                <div className=\"flex items-center gap-2.5\">\n                  <span className=\"material-symbols-outlined text-[20px]\">picture_as_pdf</span>\n                  <span>Download Assembly PDF</span>\n                </div>\n                <span className=\"material-symbols-outlined text-[18px]\">download</span>\n              </button>\n\n              {/* LDraw .ldr Download */}\n              <button\n                onClick={() => downloadLDrawFile(model)}\n                className=\"w-full h-[50px] rounded-xl font-headline-sm text-sm text-on-surface bg-surface-container-low hover:bg-surface-container border border-surface-container shadow-[0_3px_0_0_#eae7eb] active:translate-y-0.5 transition-all flex items-center justify-between px-4 cursor-pointer\"\n              >\n                <div className=\"flex items-center gap-2.5\">\n                  <span className=\"material-symbols-outlined text-tertiary text-[20px]\">layers</span>\n                  <span>LDraw CAD File (.ldr)</span>\n                </div>\n                <span className=\"material-symbols-outlined text-[18px]\">download</span>\n              </button>\n\n              {/* Parts CSV Download */}\n              <button\n                onClick={() => downloadBOMCsv(model)}\n                className=\"w-full h-[50px] rounded-xl font-headline-sm text-sm text-on-surface bg-surface-container-low hover:bg-surface-container border border-surface-container shadow-[0_3px_0_0_#eae7eb] active:translate-y-0.5 transition-all flex items-center justify-between px-4 cursor-pointer\"\n              >\n                <div className=\"flex items-center gap-2.5\">\n                  <span className=\"material-symbols-outlined text-secondary text-[20px]\">receipt_long</span>\n                  <span>Parts List (CSV)</span>\n                </div>\n                <span className=\"material-symbols-outlined text-[18px]\">download</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Card 4: Parts Sourcing Notice (Neutralized per prompt) */}\n          <div className=\"bg-surface-container-low rounded-2xl p-4 border border-surface-container\">\n            <div className=\"flex items-center gap-2 text-xs font-bold text-on-surface mb-1\">\n              <span className=\"material-symbols-outlined text-[18px] text-secondary\">inventory</span>\n              <span>Physical Brick Sourcing</span>\n            </div>\n            <p className=\"text-xs text-on-surface-variant leading-relaxed\">\n              Use your downloaded CSV or LDraw CAD file to source elements through brick marketplaces, element catalogs, or by organizing pieces from your existing physical collection.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
