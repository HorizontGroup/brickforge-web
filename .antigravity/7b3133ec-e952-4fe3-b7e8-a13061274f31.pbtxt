  file_change {
    absolute_path_uri: "file:///src/components/LandingView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ModelBuildData } from \'../types\';\nimport { EXAMPLE_BUILDS, DEFAULT_CAMERA_MODEL } from \'../data/models\';\n\ninterface LandingViewProps {\n  onOpenUpload: () => void;\n  onSelectModel: (model: ModelBuildData) => void;\n}\n\nexport const LandingView: React.FC<LandingViewProps> = ({\n  onOpenUpload,\n  onSelectModel,\n}) => {\n  const scrollToSection = (id: string) => {\n    const elem = document.getElementById(id);\n    if (elem) {\n      elem.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <div className=\"w-full\">\n      {/* 1. HERO SECTION */}\n      <section className=\"relative pt-28 md:pt-36 pb-16 md:pb-24 px-margin-mobile md:px-margin-tablet xl:px-margin-desktop max-w-[1360px] mx-auto\">\n        <div className=\"flex flex-col items-center text-center\">\n          {/* Eyebrow Pill */}\n          <div className=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-low border border-surface-container shadow-[0_2px_0_0_#eae7eb] mb-6\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-primary animate-pulse\" />\n            <span className=\"font-label-caps text-xs text-on-surface-variant tracking-wider uppercase\">\n              Standard ABS Brick Generation\n            </span>\n          </div>\n\n          {/* Main Hero Headline */}\n          <h1 className=\"font-display-hero text-3xl sm:text-4xl md:text-6xl text-on-surface max-w-4xl tracking-tight leading-[1.1] mb-6\">\n            Turn any photo into a real,{\' \'}\n            <span className=\"text-primary underline decoration-primary-fixed decoration-wavy underline-offset-8\">\n              buildable brick model.\n            </span>\n          </h1>\n\n          {/* Subtitle */}\n          <p className=\"font-body-xl text-base sm:text-lg md:text-xl text-on-surface-variant max-w-2xl leading-relaxed mb-8\">\n            Step-by-step PDF instructions, a complete parts list, and the standard LDraw CAD file \342\200\224 ready to build with physical pieces.\n          </p>\n\n          {/* CTAs */}\n          <div className=\"flex flex-wrap items-center justify-center gap-4 mb-16\">\n            <button\n              onClick={onOpenUpload}\n              className=\"inline-flex items-center gap-3 px-8 h-[56px] rounded-xl font-headline-sm text-base text-on-primary bg-primary shadow-[0_4px_0_0_#910b00] hover:bg-primary-container active:translate-y-[2px] active:shadow-[0_1px_0_0_#910b00] transition-all cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">add_a_photo</span>\n              <span>Upload Your Photo</span>\n            </button>\n\n            <button\n              onClick={() => scrollToSection(\'how-it-works\')}\n              className=\"inline-flex items-center gap-2 px-7 h-[56px] rounded-xl font-headline-sm text-base text-on-surface bg-surface-container-low hover:bg-surface-container border border-surface-container-high shadow-[0_4px_0_0_#eae7eb] active:translate-y-[2px] active:shadow-[0_1px_0_0_#eae7eb] transition-all cursor-pointer\"\n            >\n              <span>See How It Works</span>\n              <span className=\"material-symbols-outlined text-[18px]\">arrow_downward</span>\n            </button>\n          </div>\n\n          {/* Hero Transformation Preview Showcase (Stitch Approved Art Direction) */}\n          <div className=\"w-full max-w-4xl bg-surface-container-lowest rounded-[32px] p-4 sm:p-6 md:p-8 border border-surface-container shadow-[0_12px_36px_rgba(27,27,30,0.06),0_6px_0_0_#eae7eb]\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 items-center relative\">\n              {/* Left: Input Photo */}\n              <div className=\"flex flex-col items-center\">\n                <div className=\"relative w-full aspect-square max-w-[340px] rounded-2xl overflow-hidden shadow-[0_4px_12px_rgba(0,0,0,0.08)] group\">\n                  <img\n                    src={DEFAULT_CAMERA_MODEL.photoUrl}\n                    alt=\"Original photo input\"\n                    className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute top-3 left-3 bg-surface/90 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-on-surface shadow-sm\">\n                    YOUR PHOTO\n                  </div>\n                  <div className=\"absolute bottom-3 left-3 right-3 bg-on-surface/80 backdrop-blur-md px-3 py-1.5 rounded-xl text-[12px] font-medium text-surface text-left\">\n                    Pink Vintage Instant Camera\n                  </div>\n                </div>\n              </div>\n\n              {/* Center Transition Pill on desktop */}\n              <div className=\"hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container items-center justify-center shadow-[0_4px_0_0_#6f5400]\">\n                <span className=\"material-symbols-outlined text-[24px]\">sync_alt</span>\n              </div>\n\n              {/* Right: Brick MOC Render */}\n              <div className=\"flex flex-col items-center\">\n                <div className=\"relative w-full aspect-square max-w-[340px] rounded-2xl overflow-hidden bg-surface-container-low shadow-[0_4px_12px_rgba(0,0,0,0.08)] flex items-center justify-center group\">\n                  <img\n                    src={DEFAULT_CAMERA_MODEL.renderUrl}\n                    alt=\"Generated brick model\"\n                    className=\"w-[90%] h-[90%] object-contain group-hover:scale-105 transition-transform duration-500\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute top-3 right-3 bg-primary text-on-primary px-3 py-1 rounded-full text-xs font-bold shadow-[0_2px_0_0_#910b00]\">\n                    BUILDABLE MOC\n                  </div>\n                  <div className=\"absolute bottom-3 left-3 right-3 bg-surface/95 backdrop-blur-md px-3 py-1.5 rounded-xl text-[12px] font-bold text-on-surface flex items-center justify-between shadow-sm\">\n                    <span>132 Real ABS Pieces</span>\n                    <span className=\"text-primary\">15 Steps</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"mt-6 pt-4 border-t border-surface-container flex flex-wrap items-center justify-between gap-4 text-xs font-medium text-on-surface-variant\">\n              <span className=\"flex items-center gap-1.5\">\n                <span className=\"material-symbols-outlined text-primary text-[16px]\">verified</span>\n                Verified Clutch Power &amp; Stability\n              </span>\n              <span className=\"flex items-center gap-1.5\">\n                <span className=\"material-symbols-outlined text-secondary text-[16px]\">inventory_2</span>\n                Standard Commercial Brick Library\n              </span>\n              <button\n                onClick={() => onSelectModel(DEFAULT_CAMERA_MODEL)}\n                className=\"font-bold text-primary hover:underline flex items-center gap-1 cursor-pointer ml-auto\"\n              >\n                <span>Inspect this model</span>\n                <span className=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 2. REAL BUILDS GALLERY SECTION */}\n      <section id=\"examples\" className=\"py-16 bg-surface-container-low/50 border-y border-surface-container\">\n        <div className=\"max-w-[1360px] mx-auto px-margin-mobile md:px-margin-tablet xl:px-margin-desktop\">\n          <div className=\"text-center max-w-2xl mx-auto mb-12\">\n            <span className=\"font-label-caps text-xs text-primary uppercase tracking-wider\">\n              Showcase Gallery\n            </span>\n            <h2 className=\"font-headline-xl text-3xl md:text-4xl text-on-surface mt-2 mb-3\">\n              Real Builds, Real Pieces\n            </h2>\n            <p className=\"font-body-md text-base text-on-surface-variant\">\n              Every design is engineered for physical tabletop assembly \342\200\224 no floating bricks, no illegal stresses, and no impossible connections.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {EXAMPLE_BUILDS.map((item) => (\n              <div\n                key={item.id}\n                className=\"bg-surface-container-lowest rounded-2xl p-4 border border-surface-container shadow-[0_4px_0_0_#eae7eb] hover:shadow-[0_8px_0_0_#eae7eb] hover:-translate-y-1 transition-all flex flex-col\"\n              >\n                <div className=\"grid grid-cols-2 gap-2 mb-3\">\n                  <div className=\"relative aspect-square rounded-xl overflow-hidden bg-surface-container\">\n                    <img\n                      src={item.photoUrl}\n                      alt={`${item.name} photo`}\n                      className=\"w-full h-full object-cover\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <span className=\"absolute bottom-1.5 left-1.5 bg-black/60 text-white text-[9px] font-bold px-1.5 py-0.5 rounded\">\n                      PHOTO\n                    </span>\n                  </div>\n                  <div className=\"relative aspect-square rounded-xl overflow-hidden bg-surface-container-low flex items-center justify-center\">\n                    <img\n                      src={item.renderUrl}\n                      alt={`${item.name} build`}\n                      className=\"w-full h-full object-cover\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <span className=\"absolute bottom-1.5 left-1.5 bg-primary text-white text-[9px] font-bold px-1.5 py-0.5 rounded shadow-sm\">\n                      BRICK MOC\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center justify-between mt-auto pt-2 border-t border-surface-container\">\n                  <div>\n                    <h3 className=\"font-headline-sm text-base text-on-surface\">{item.name}</h3>\n                    <p className=\"font-body-sm text-xs text-on-surface-variant\">{item.pieceCount} pieces</p>\n                  </div>\n                  <button\n                    onClick={() => {\n                      onSelectModel({\n                        ...DEFAULT_CAMERA_MODEL,\n                        id: `BF-${Math.floor(1000 + Math.random() * 9000)}`,\n                        name: item.name,\n                        category: item.name,\n                        photoUrl: item.photoUrl,\n                        renderUrl: item.renderUrl,\n                        pieceCount: item.pieceCount,\n                      });\n                    }}\n                    className=\"px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container font-headline-sm text-xs text-primary font-bold transition-colors cursor-pointer\"\n                  >\n                    View Model\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* 3. EVERYTHING YOU NEED TO BUILD IT (WHAT YOU GET) */}\n      <section id=\"what-you-get\" className=\"py-20 max-w-[1360px] mx-auto px-margin-mobile md:px-margin-tablet xl:px-margin-desktop\">\n        <div className=\"text-center max-w-2xl mx-auto mb-14\">\n          <span className=\"font-label-caps text-xs text-primary uppercase tracking-wider\">\n            Deliverables\n          </span>\n          <h2 className=\"font-headline-xl text-3xl md:text-4xl text-on-surface mt-2 mb-3\">\n            Everything You Need to Build It\n          </h2>\n          <p className=\"font-body-md text-base text-on-surface-variant\">\n            You receive complete, professional instructions and parts files ready to assemble your creation.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {/* Card 1: PDF Guide */}\n          <div className=\"bg-surface-container-lowest rounded-2xl p-6 border border-surface-container shadow-[0_4px_0_0_#eae7eb] flex flex-col\">\n            <div className=\"w-12 h-12 rounded-xl bg-primary-fixed text-primary flex items-center justify-center mb-5 shadow-[0_2px_0_0_#ffb4a7]\">\n              <span className=\"material-symbols-outlined text-[28px]\">picture_as_pdf</span>\n            </div>\n            <h3 className=\"font-headline-sm text-xl text-on-surface mb-2\">Step-by-Step PDF Guide</h3>\n            <p className=\"font-body-md text-sm text-on-surface-variant leading-relaxed\">\n              Clear, numbered assembly pages styled like official instruction booklets, featuring sub-assembly breakouts and part callouts.\n            </p>\n          </div>\n\n          {/* Card 2: Complete Parts List */}\n          <div className=\"bg-surface-container-lowest rounded-2xl p-6 border border-surface-container shadow-[0_4px_0_0_#eae7eb] flex flex-col\">\n            <div className=\"w-12 h-12 rounded-xl bg-secondary-fixed text-secondary flex items-center justify-center mb-5 shadow-[0_2px_0_0_#f6bf22]\">\n              <span className=\"material-symbols-outlined text-[28px]\">receipt_long</span>\n            </div>\n            <h3 className=\"font-headline-sm text-xl text-on-surface mb-2\">Complete Parts Manifest</h3>\n            <p className=\"font-body-md text-sm text-on-surface-variant leading-relaxed\">\n              Standard XML and CSV formats listing official element IDs, color names, and exact quantities for element sourcing or digging through bins.\n            </p>\n          </div>\n\n          {/* Card 3: LDraw CAD File */}\n          <div className=\"bg-surface-container-lowest rounded-2xl p-6 border border-surface-container shadow-[0_4px_0_0_#eae7eb] flex flex-col\">\n            <div className=\"w-12 h-12 rounded-xl bg-tertiary-fixed text-tertiary flex items-center justify-center mb-5 shadow-[0_2px_0_0_#a2c9ff]\">\n              <span className=\"material-symbols-outlined text-[28px]\">layers</span>\n            </div>\n            <h3 className=\"font-headline-sm text-xl text-on-surface mb-2\">LDraw 3D CAD (.ldr)</h3>\n            <p className=\"font-body-md text-sm text-on-surface-variant leading-relaxed\">\n              Industry standard 3D CAD model file compatible with BrickLink Studio, LDView, and other digital building tools.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* 4. HOW IT WORKS (CHILD\'S PLAY TO START) */}\n      <section id=\"how-it-works\" className=\"py-20 bg-surface-container-low/40 border-t border-surface-container\">\n        <div className=\"max-w-[1360px] mx-auto px-margin-mobile md:px-margin-tablet xl:px-margin-desktop\">\n          <div className=\"text-center max-w-2xl mx-auto mb-14\">\n            <span className=\"font-label-caps text-xs text-primary uppercase tracking-wider\">\n              Simple Workflow\n            </span>\n            <h2 className=\"font-headline-xl text-3xl md:text-4xl text-on-surface mt-2 mb-3\">\n              How It Works\n            </h2>\n            <p className=\"font-body-md text-base text-on-surface-variant\">\n              From camera roll to your building desk in three straightforward steps.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 relative\">\n            {/* Step 1 */}\n            <div className=\"bg-surface-container-lowest rounded-2xl p-6 border border-surface-container shadow-[0_4px_0_0_#eae7eb] relative\">\n              <span className=\"font-display-hero text-4xl font-extrabold text-outline-variant/60 block mb-2\">\n                01\n              </span>\n              <h3 className=\"font-headline-sm text-xl text-on-surface mb-2\">Upload a Photo</h3>\n              <p className=\"font-body-md text-sm text-on-surface-variant leading-relaxed\">\n                Choose any clear picture of a pet, vehicle, building, vintage toy, or personal keepsake.\n              </p>\n            </div>\n\n            {/* Step 2 */}\n            <div className=\"bg-surface-container-lowest rounded-2xl p-6 border border-surface-container shadow-[0_4px_0_0_#eae7eb] relative\">\n              <span className=\"font-display-hero text-4xl font-extrabold text-outline-variant/60 block mb-2\">\n                02\n              </span>\n              <h3 className=\"font-headline-sm text-xl text-on-surface mb-2\">Review the Blueprint</h3>\n              <p className=\"font-body-md text-sm text-on-surface-variant leading-relaxed\">\n                Inspect the 3D model render, piece breakdown, dimensions, and color palette before proceeding.\n              </p>\n            </div>\n\n            {/* Step 3 */}\n            <div className=\"bg-surface-container-lowest rounded-2xl p-6 border border-surface-container shadow-[0_4px_0_0_#eae7eb] relative\">\n              <span className=\"font-display-hero text-4xl font-extrabold text-outline-variant/60 block mb-2\">\n                03\n              </span>\n              <h3 className=\"font-headline-sm text-xl text-on-surface mb-2\">Build in Real Life</h3>\n              <p className=\"font-body-md text-sm text-on-surface-variant leading-relaxed\">\n                Download your step-by-step PDF manual, LDraw CAD file, and parts list, then start assembling.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 5. BUILDABILITY PRINCIPLES (NEUTRALIZED CONTENT) */}\n      <section id=\"buildability\" className=\"py-20 max-w-[1360px] mx-auto px-margin-mobile md:px-margin-tablet xl:px-margin-desktop\">\n        <div className=\"bg-surface-container-lowest rounded-[32px] p-8 md:p-12 border border-surface-container shadow-[0_8px_24px_rgba(27,27,30,0.05),0_6px_0_0_#eae7eb]\">\n          <div className=\"max-w-3xl\">\n            <span className=\"font-label-caps text-xs text-primary uppercase tracking-wider\">\n              Engineering Standards\n            </span>\n            <h2 className=\"font-headline-xl text-3xl md:text-4xl text-on-surface mt-2 mb-4\">\n              Made to Actually Build\n            </h2>\n            <p className=\"font-body-md text-base text-on-surface-variant leading-relaxed mb-8\">\n              We design models specifically for physical construction using standard injection-molded ABS bricks.\n            </p>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div className=\"flex items-start gap-3 p-4 rounded-xl bg-surface-container-low\">\n                <span className=\"material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5\">\n                  check_circle\n                </span>\n                <div>\n                  <h4 className=\"font-headline-sm text-sm text-on-surface\">Physical ABS Geometry</h4>\n                  <p className=\"font-body-sm text-xs text-on-surface-variant mt-1\">\n                    Every piece adheres strictly to standard stud pitch and plate thickness specifications.\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3 p-4 rounded-xl bg-surface-container-low\">\n                <span className=\"material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5\">\n                  check_circle\n                </span>\n                <div>\n                  <h4 className=\"font-headline-sm text-sm text-on-surface\">Clutch Power Verification</h4>\n                  <p className=\"font-body-sm text-xs text-on-surface-variant mt-1\">\n                    Layers interlock to prevent structural collapse and fragile single-stud connections.\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3 p-4 rounded-xl bg-surface-container-low\">\n                <span className=\"material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5\">\n                  check_circle\n                </span>\n                <div>\n                  <h4 className=\"font-headline-sm text-sm text-on-surface\">Common Color Palette</h4>\n                  <p className=\"font-body-sm text-xs text-on-surface-variant mt-1\">\n                    Parts use widely produced brick colors for practical element availability.\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3 p-4 rounded-xl bg-surface-container-low\">\n                <span className=\"material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5\">\n                  check_circle\n                </span>\n                <div>\n                  <h4 className=\"font-headline-sm text-sm text-on-surface\">Standard Part IDs</h4>\n                  <p className=\"font-body-sm text-xs text-on-surface-variant mt-1\">\n                    Exported parts lists use standard 4-digit and 5-digit element catalog codes.\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 6. BOTTOM BANNER */}\n      <section className=\"pb-16 max-w-[1360px] mx-auto px-margin-mobile md:px-margin-tablet xl:px-margin-desktop\">\n        <div className=\"bg-primary rounded-[32px] p-8 md:p-14 text-center text-on-primary shadow-[0_8px_0_0_#910b00] relative overflow-hidden\">\n          <div className=\"max-w-2xl mx-auto relative z-10\">\n            <h2 className=\"font-display-hero text-3xl md:text-5xl font-extrabold mb-4\">\n              Ready to build something unforgettable?\n            </h2>\n            <p className=\"font-body-xl text-base md:text-lg text-on-primary/90 mb-8 leading-relaxed\">\n              Upload a photo and preview your custom brick model in minutes.\n            </p>\n            <button\n              onClick={onOpenUpload}\n              className=\"inline-flex items-center gap-3 px-8 h-[56px] rounded-xl font-headline-sm text-base text-primary bg-surface shadow-[0_4px_0_0_#eae7eb] hover:bg-surface-container-lowest active:translate-y-[2px] transition-all cursor-pointer font-bold\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">add_a_photo</span>\n              <span>Upload Your Photo</span>\n            </button>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
    }
